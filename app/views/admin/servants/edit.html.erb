<style>
  body { background: #121212; color: #fff; font-family: sans-serif; padding: 20px; }
  .form-group { margin-bottom: 15px; }
  label { display: block; margin-bottom: 5px; color: #90caf9; }
  input[type="text"], input[type="number"] { width: 100%; padding: 8px; background: #2d2d2d; color: #fff; border: 1px solid #444; border-radius: 4px; }
  
  /* Делаем текстовые поля моноширинными для удобного редактирования навыков и шорткодов */
  textarea { width: 100%; height: 150px; padding: 8px; background: #2d2d2d; color: #fff; border: 1px solid #444; border-radius: 4px; font-family: monospace; font-size: 14px; line-height: 1.4; white-space: pre-wrap; }
  
  .btn-submit { background: #90caf9; color: #000; padding: 10px 20px; border: none; font-size: 1.1em; cursor: pointer; border-radius: 4px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
</style>

<h1>Редактирование: <%= @servant.game_id %> - <%= @servant.name %></h1>
<a href="<%= admin_servants_path %>" style="color: #ccc;">← Назад к списку</a>
<br><br>

<%= form_with model: @servant, url: admin_servant_path(@servant.game_id), method: :patch, local: true do |f| %>
  
  <div class="grid-2">
    <div class="form-group">
      <label>Имя</label>
      <%= f.text_field :name %>
    </div>
    <div class="form-group">
      <label>Класс</label>
      <%= f.text_field :servant_class %>
    </div>
    <div class="form-group">
      <label>Редкость</label>
      <%= f.number_field :rarity %>
    </div>
    <div class="form-group">
      <label>Трейты (через запятую)</label>
      <!-- Превращаем массив обратно в строку для формы -->
      <%= f.text_field :traits_string, value: @servant.traits&.join(', ') %>
    </div>
    <div class="form-group">
      <label>Именные Карты (через запятую, напр. CE-027)</label>
      <%= f.text_field :craft_essences_string, value: @servant.craft_essences&.join(', ') %>
    </div>
    <div class="form-group">
      <label>Atlas ID</label>
      <div style="display: flex; gap: 10px; align-items: center;">
        <%= f.number_field :atlas_id, style: "flex-grow: 1;" %>
        
        <%# Используем link_to c turbo_method для обхода блокировки форм %>
        <%= link_to "🔄 Синхронизировать", 
                    sync_atlas_admin_servant_path(@servant.game_id), 
                    data: { turbo_method: :post }, 
                    style: "background: #cf6679; color: #000; padding: 8px 12px; border-radius: 4px; font-weight: bold; text-decoration: none; cursor: pointer; display: inline-block; white-space: nowrap;" %>
      </div>
    </div>
    <div class="form-group">
      <label>English Name (Авто)</label>
      <%= f.text_field :en_name %>
    </div>
    <div class="form-group">
      <label>English Class (Авто)</label>
      <%= f.text_field :en_servant_class %>
    </div>
  </div>

  <hr style="border-color: #333; margin: 20px 0;">

  <div class="grid-2">
    <div class="form-group">
      <label>Очки Жизни (HP)</label>
      <%= f.number_field :hp %>
    </div>
    <div class="form-group">
      <label>Урон (Damage)</label>
      <%= f.number_field :damage %>
    </div>
    <div class="form-group">
      <label>Радиус атаки</label>
      <%= f.number_field :attack_range %>
    </div>
    <div class="form-group">
      <label>Sort ID (Порядок)</label>
      <%= f.number_field :sort_id %>
    </div>
    <div class="form-group">
      <label>Магическая защита</label>
      <%= f.number_field :magic_defense %>
    </div>
    <div class="form-group">
      <label>Магическая атака (Урон)</label>
      <%= f.number_field :magic_damage %>
    </div>
  </div>

  <hr style="border-color: #333; margin: 20px 0;">

  <div class="form-group">
    <label>Классовые Навыки</label>
    <%= f.text_area :class_skills %>
  </div>

  <div class="form-group">
    <label>Личные Навыки</label>
    <%= f.text_area :personal_skills %>
  </div>

  <div class="form-group">
    <label>Небесный Фантазм</label>
    <%= f.text_area :noble_phantasm %>
  </div>

  <div class="form-group">
    <label>Структура страницы (Шорткоды: [preview_image], [галерея...])</label>
    <%= f.text_area :page_layout, value: @servant.layout_to_use, style: "height: 250px; border-color: #cf6679;" %>
  </div>

  <%= f.submit "💾 Сохранить изменения", class: "btn-submit" %>
<% end %>

  <!-- ВЫВОД ОШИБОК ИЛИ УСПЕХОВ ЗАГРУЗКИ ФАЙЛА -->
<% if flash[:notice] %>
  <div style="background: #03dac6; color: #000; padding: 10px; margin-bottom: 20px;"><%= flash[:notice] %></div>
<% elsif flash[:alert] %>
  <div style="background: #cf6679; color: #000; padding: 10px; margin-bottom: 20px;"><%= flash[:alert] %></div>
<% end %>

<!-- МЕНЕДЖЕР СПРАЙТОВ -->
<div style="background: #1e1e1e; border: 1px solid #444; border-radius: 8px; padding: 20px; margin-bottom: 30px; margin-top: 30px;">
  <h2 style="margin-top: 0; color: #90caf9;">Менеджер спрайтов</h2>
  
  <!-- Форма загрузки. Атрибуты name="sprite_files[]" и multiple разрешают грузить пачку файлов -->
  <%= form_with url: upload_sprite_admin_servant_path(@servant.game_id), multipart: true, local: true, style: "display: flex; gap: 10px; align-items: center; margin-bottom: 20px;" do |f| %>
    <input type="file" name="sprite_files[]" accept="image/png" multiple required style="color: #fff;">
    <button type="submit" style="background: #90caf9; color: #000; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold;">Загрузить файлы</button>
  <% end %>

  <!-- Галерея текущих спрайтов -->
  <% if @sprites.any? %>
    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
      <% @sprites.each do |sprite| %>
        <div style="background: #2d2d2d; padding: 10px; border-radius: 4px; text-align: center; border: 1px solid #444; position: relative;">
          
          <!-- Кнопка удаления (Крестик в углу) -->
          <%= button_to "❌", delete_sprite_admin_servant_path(@servant.game_id, filename: sprite), method: :delete, form: {style: "position: absolute; top: 5px; right: 5px; margin: 0;"}, style: "background: #ef5350; border: none; border-radius: 3px; cursor: pointer; padding: 2px 5px; font-size: 0.8rem;" %>

          <!-- ?v=Time... заставляет браузер сбросить кэш и показать новую картинку при перезаписи -->
          <img src="//servant-data.<%= Rails.configuration.x.base_domain %>/sprite/<%= @servant.game_id %>/<%= sprite %>?v=<%= Time.now.to_i %>" style="height: 120px; width: 120px; object-fit: contain; background: #000; display: block; margin-bottom: 8px;">
          <%= form_with url: rename_sprite_admin_servant_path(@servant.game_id), method: :patch, local: true, style: "display: flex; gap: 5px; justify-content: center;" do |f| %>
            <%= f.hidden_field :old_filename, value: sprite %>
            
            <!-- Выводим имя без .png для удобства редактирования -->
            <%= f.text_field :new_filename, value: sprite.sub('.png', ''), style: "width: 90px; padding: 4px; font-size: 0.8rem; background: #1e1e1e; color: #fff; border: 1px solid #555; border-radius: 3px; text-align: center;" %>
            
            <button type="submit" title="Сохранить имя" style="background: #03dac6; border: none; border-radius: 3px; cursor: pointer; font-size: 0.8rem; padding: 4px 6px;">💾</button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p style="color: #888;">В папке пока нет ни одного спрайта.</p>
  <% end %>
</div>



<script>
  // Перед тем как страница начнет перезагружаться (отправка формы или клик) - запоминаем высоту
  window.addEventListener("turbo:before-visit", () => sessionStorage.setItem("edit_scroll", window.scrollY));
  window.addEventListener("beforeunload", () => sessionStorage.setItem("edit_scroll", window.scrollY));

  // Как только страница загрузилась заново - прокручиваем обратно
  const restoreScroll = () => {
    let scrollPos = sessionStorage.getItem("edit_scroll");
    if (scrollPos) {
      window.scrollTo(0, parseInt(scrollPos));
      sessionStorage.removeItem("edit_scroll"); // Очищаем память
    }
  };
  
  document.addEventListener("turbo:load", restoreScroll);
  document.addEventListener("DOMContentLoaded", restoreScroll);
</script>